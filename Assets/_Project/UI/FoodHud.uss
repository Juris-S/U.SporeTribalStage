.food {
    position: absolute;
    left: 12px;
    top: 12px;
    width: 170px;
    height: 44px;
    flex-direction: row;
    align-items: center;
}

/* Soft dark backdrop (shared with the toasts) is assigned in FoodHud.cs. */
.food__bar {
    position: absolute;
    left: 22px;
    right: 0;
    top: 8px;
    height: 28px;
    justify-content: center;
    align-items: flex-start;
    /* Icon covers the first 22px of the bar; start the number just past it. */
    padding-left: 30px;
}

.food__count {
    margin: 0;
    padding: 0;
    font-size: 26px;
    -unity-font-definition: url('Fonts/Fredoka-Bold.ttf');
    /* Fredoka's line metrics sit the digits low; nudge up to centre them in the bar. */
    translate: 0 -2px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.55);
}

.food__icon {
    position: absolute;
    left: 0;
    width: 44px;
    height: 44px;
}
