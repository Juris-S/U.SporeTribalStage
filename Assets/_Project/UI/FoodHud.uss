.food {
    position: absolute;
    left: 12px;
    top: 12px;
    width: 150px;
    height: 44px;
    flex-direction: row;
    align-items: center;
}

/* Gradient background (dark red fading out to the right) is assigned in FoodHud.cs: USS has no gradient syntax. */
.food__bar {
    position: absolute;
    left: 22px;
    right: 0;
    top: 8px;
    height: 28px;
    justify-content: center;
    align-items: flex-start;
    /* Icon covers the first 22px of the bar; start the number just past it. */
    padding-left: 30px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
}

.food__count {
    margin: 0;
    padding: 0;
    font-size: 26px;
    -unity-font-definition: url('Fonts/Fredoka-Bold.ttf');
    /* Fredoka's line metrics sit the digits low; nudge up to centre them in the bar. */
    translate: 0 -2px;
    color: rgb(255, 85, 85);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(110, 10, 25);
}

.food__icon {
    position: absolute;
    left: 0;
    width: 44px;
    height: 44px;
}
