/* Shared look for runtime HUD pieces built in code (toasts, tooltips, hut popup, results, bars). */

.hud-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* Soft dark band with faded left/right edges; the texture is assigned in HudLayer.cs. */
.hud-backdrop {
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 32;
    -unity-slice-right: 32;
}

.hud-label {
    margin: 0;
    padding: 0 0 3px 0;
    -unity-font-definition: url('Fonts/Fredoka-Bold.ttf');
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.55);
}

.hud-button {
    -unity-font-definition: url('Fonts/Fredoka-Bold.ttf');
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.55);
    margin: 0;
    padding: 0 18px 3px 18px;
    height: 34px;
    border-width: 0;
    border-radius: 17px;
    font-size: 17px;
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.18);
    transition-property: scale, background-color;
    transition-duration: 0.14s;
    transition-timing-function: ease-out-back;
}

.hud-button:hover {
    scale: 1.07 1.07;
    background-color: rgba(255, 255, 255, 0.3);
}

.hud-button:active {
    scale: 0.94 0.94;
}

.hud-button--off,
.hud-button--off:hover,
.hud-button--off:active {
    scale: 1 1;
    opacity: 0.5;
    background-color: rgba(255, 255, 255, 0.1);
}

.toast-stack {
    position: absolute;
    left: 0;
    right: 0;
    top: 12%;
    align-items: center;
}

.toast {
    min-height: 50px;
    max-width: 90%;
    margin-bottom: 6px;
    padding: 0 48px;
    justify-content: center;
}

.toast__text {
    font-size: 22px;
}

.tooltip {
    position: absolute;
    display: none;
    translate: -50% -100%;
    margin-top: -8px;
    padding: 6px 48px;
    align-items: center;
}

.tooltip__name {
    font-size: 18px;
}

.tooltip__cost {
    font-size: 15px;
    color: rgb(255, 214, 102);
}

.tooltip--short .tooltip__cost {
    color: rgb(255, 110, 110);
}

.hut-popup {
    position: absolute;
    display: none;
    translate: -50% -50%;
    padding: 8px 52px 12px 52px;
    align-items: center;
}

.hut-popup__title {
    font-size: 20px;
    margin-bottom: 6px;
}

.health-bar {
    position: absolute;
    display: none;
    translate: -50% 0;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.6);
}

.health-bar__ghost,
.health-bar__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-radius: 3px;
}

.health-bar__ghost {
    background-color: rgba(255, 255, 255, 0.75);
}

.sleep-indicator {
    position: absolute;
    display: none;
    translate: -50% -50%;
    font-size: 22px;
}

.result {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.6);
    opacity: 0;
}

.result__title {
    font-size: 84px;
    -unity-text-outline-width: 4px;
    opacity: 0;
}

.result__title--win {
    color: rgb(255, 214, 102);
}

.result__title--lose {
    color: rgb(255, 110, 110);
    -unity-text-outline-color: rgb(0, 0, 0);
}

.result__subtitle {
    font-size: 28px;
    margin-bottom: 28px;
    opacity: 0;
}

.result__button {
    height: 60px;
    min-width: 240px;
    border-radius: 30px;
    font-size: 28px;
    opacity: 0;
}

.tribe-panel {
    position: absolute;
    right: 12px;
    top: 50%;
    translate: 0 -50%;
    align-items: center;
}

.tribe-panel__list {
    align-items: center;
}

.tribe-chip {
    width: 72px;
    height: 72px;
    margin-bottom: 12px;
    border-width: 4px;
    border-radius: 18px;
    overflow: hidden;
    border-color: rgb(255, 252, 244);
    transition-property: scale, border-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out-back;
}

.tribe-chip:hover {
    scale: 1.08 1.08;
    border-color: rgb(255, 255, 255);
}

.tribe-chip--chief {
    margin-bottom: 28px;
    border-color: rgb(255, 214, 102);
}

.tribe-chip--selected,
.tribe-chip--selected:hover {
    border-color: rgb(96, 176, 255);
    scale: 1.1 1.1;
}

.tribe-chip__portrait {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.tribe-chip__tool {
    position: absolute;
    left: 2px;
    bottom: 2px;
    width: 34px;
    height: 34px;
    -unity-background-scale-mode: scale-to-fit;
    opacity: 0.95;
}

.tribe-panel__all {
    margin-bottom: 14px;
    height: 32px;
    min-width: 72px;
    padding: 0 18px 3px 18px;
    font-size: 16px;
    color: rgb(58, 46, 40);
    -unity-text-outline-width: 0;
    background-color: rgb(255, 252, 244);
}

.tribe-panel__all:hover {
    background-color: rgb(255, 255, 255);
}

.tribe-chip__track {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 3px;
    height: 7px;
    border-radius: 4px;
    background-color: rgb(255, 252, 244);
    display: none;
}

.tribe-chip--hurt .tribe-chip__track {
    display: flex;
}

.tribe-chip__health {
    height: 7px;
    border-radius: 4px;
}

.progress {
    position: absolute;
    left: 50%;
    bottom: 22px;
    width: 55%;
    max-width: 760px;
    padding: 3px;
    translate: -50% 0;
    border-radius: 14px;
    background-color: rgb(255, 252, 244);
}

.progress__caption {
    font-size: 16px;
    margin-bottom: 4px;
}

.progress__track {
    align-self: stretch;
    height: 22px;
    border-radius: 11px;
    background-color: rgb(40, 46, 72);
}

.progress__fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-top-left-radius: 11px;
    border-bottom-left-radius: 11px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    background-color: rgb(110, 200, 90);
}

.progress__markers {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.progress-marker {
    position: absolute;
    top: -9px;
    width: 40px;
    height: 40px;
    translate: -50% 0;
    border-radius: 20px;
    background-color: rgb(255, 252, 244);
    align-items: center;
    justify-content: center;
}

.progress-marker__bead {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    align-items: center;
    justify-content: center;
}

.progress-marker__glyph {
    width: 20px;
    height: 20px;
    -unity-background-scale-mode: scale-to-fit;
}

.progress-marker--done {
    background-color: rgb(255, 226, 130);
}

.minimap {
    position: absolute;
    left: 16px;
    bottom: 16px;
    width: 220px;
    height: 220px;
}

.minimap__ring {
    position: absolute;
    left: 0;
    top: 0;
    width: 200px;
    height: 200px;
    border-radius: 100px;
    background-color: rgb(255, 252, 244);
}

.minimap__view {
    position: absolute;
    left: 7px;
    top: 7px;
    width: 186px;
    height: 186px;
    border-radius: 93px;
    overflow: hidden;
    background-color: rgb(60, 110, 150);
}

.minimap__image {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.minimap__dots {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.minimap__dot {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 5px;
    translate: -50% -50%;
    align-items: center;
    justify-content: center;
    background-color: rgb(40, 46, 72);
}

.minimap__dot-fill {
    width: 5px;
    height: 5px;
    border-radius: 3px;
}

.minimap__dot--mine {
    width: 11px;
    height: 11px;
    border-radius: 6px;
}

.minimap__dot--mine .minimap__dot-fill {
    width: 7px;
    height: 7px;
    border-radius: 4px;
}

.minimap__dot--chief,
.minimap__dot--mine.minimap__dot--chief {
    width: 15px;
    height: 15px;
    border-radius: 8px;
    background-color: rgb(255, 214, 102);
}

.minimap__dot--chief .minimap__dot-fill,
.minimap__dot--mine.minimap__dot--chief .minimap__dot-fill {
    width: 9px;
    height: 9px;
    border-radius: 5px;
}

.minimap__arrow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    translate: -50% -50%;
    background-color: rgb(255, 255, 255);
}

.minimap__zoom {
    position: absolute;
    width: 38px;
    height: 38px;
    padding: 0 0 4px 0;
    border-radius: 19px;
    font-size: 26px;
    color: rgb(58, 46, 40);
    -unity-text-outline-width: 0;
    background-color: rgb(255, 252, 244);
}

.minimap__zoom:hover {
    background-color: rgb(255, 255, 255);
}

.minimap__zoom--in {
    left: 176px;
    top: 62px;
}

.minimap__zoom--out {
    left: 174px;
    top: 108px;
}

.minimap__food {
    position: absolute;
    left: 12px;
    top: 156px;
    width: 130px;
    height: 44px;
    padding: 0 16px 0 48px;
    border-radius: 22px;
    flex-direction: row;
    align-items: center;
    background-color: rgb(255, 252, 244);
}

.minimap__food-icon {
    position: absolute;
    left: -8px;
    top: -3px;
    width: 50px;
    height: 50px;
    border-radius: 25px;
    align-items: center;
    justify-content: center;
    background-color: rgb(40, 46, 72);
    border-width: 3px;
    border-color: rgb(255, 252, 244);
}

.minimap__food-glyph {
    width: 26px;
    height: 26px;
    -unity-background-scale-mode: scale-to-fit;
}

.minimap__food-count {
    font-size: 30px;
    color: rgb(58, 46, 40);
    -unity-text-outline-width: 0;
    padding: 0 0 2px 0;
    -unity-text-align: middle-left;
}
